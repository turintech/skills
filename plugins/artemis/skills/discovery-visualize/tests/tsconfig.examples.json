{
  "compilerOptions": {
    "baseUrl": "..",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "cursor/canvas": ["tests/cursor-canvas.d.ts"],
      "react": ["tests/react-shim.d.ts"],
      "react/jsx-runtime": ["tests/react-shim.d.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "jsx": "react-jsx"
  },
  "include": [
    "../examples/**/*.tsx",
    "react-shim.d.ts",
    "cursor-canvas.d.ts"
  ]
}
